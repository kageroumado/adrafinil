    "Version %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版本 %@"
          }
        }
      }
    },
    "Version %@ is downloaded and verified — it installs at a quiet moment, when your Mac is idle and no agents are being kept awake." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版本 %@ 已下载并验证——它会在空闲时安装，即你的 Mac 处于空闲且没有 Agent 需要保持唤醒时。"
          }
        }
      }
    },
