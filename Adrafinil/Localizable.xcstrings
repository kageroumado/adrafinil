      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待期间"
          }
        }
      }
    },
    "Windows & flows" : {
      "shouldTranslate" : false
    },
    "With the icon hidden, Adrafinil keeps running in the background. Reopen it from Spotlight or Finder to bring its menu back as a window." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏图标后，Adrafinil 会继续在后台运行。从“聚焦”或“访达”重新打开它，即可将菜单以窗口形式调出。"
          }
        }
      }
    },
