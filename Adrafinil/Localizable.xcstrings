    },
    "Adrafinil is set up": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Adrafinil 已设置完成"
          }
        }
      }
    },
    "Adrafinil keeps your Mac awake — even with the lid closed — while your AI agents work.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你的 AI agent 工作时，Adrafinil 会让 Mac 保持唤醒——即使合上盖子。"
