    "Idle agents" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空闲的 Agent"
          }
        }
      }
    },
    "If an agent does nothing for a while, Adrafinil stops keeping your Mac awake for it — so a stuck or crashed agent can't hold it up forever." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果某个 Agent 一段时间没有任何活动，Adrafinil 就不再为它保持 Mac 唤醒——这样卡住或崩溃的 Agent 就不会让 Mac 一直无法睡眠。"
          }
        }
      }
    },
    "In-place updating is disabled in development builds." : {
      "shouldTranslate" : false
