        }
      }
    },
    "Adrafinil updated itself at a quiet moment. See what's new.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Adrafinil 已在空闲时自动更新。看看有什么新变化。"
          }
        }
      }
    },
    "Adrafinil — UI Gallery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
