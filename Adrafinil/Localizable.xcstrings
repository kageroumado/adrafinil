    "The %@ command" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 命令"
          }
        }
      }
    },
    "The controls you're looking at now — its window opens from the menu bar." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
