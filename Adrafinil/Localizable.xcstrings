{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ [Releases page.](https://github.com/kageroumado/adrafinil/releases)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@[前往发布页面。](https://github.com/kageroumado/adrafinil/releases)"
          }
        }
      }
    },
    "%@ may not be tracked" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可能未被跟踪"
          }
        }
      }
    },
    "%@'s Adrafinil hook isn't in the form Adrafinil expects — likely edited by hand or left over from an update — so it may not notice when %@ is working and keep your Mac awake. Reconnect restores it without touching your other %@ settings." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的 Adrafinil 钩子与 Adrafinil 预期的格式不符——可能被手动编辑过，或是更新后遗留的——因此可能无法察觉 %2$@ 何时在工作并让你的 Mac 保持唤醒。重新连接会恢复它，不会改动你的其他 %3$@ 设置。"
          }
        }
      }
    },
    "%@'s settings file couldn't be read (it may contain comments or a syntax error). Adrafinil won't modify it in this state — fix the file, then try connecting again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@ 的设置文件（可能包含注释或语法错误）。在这种状态下 Adrafinil 不会修改它——请修复文件后再尝试连接。"
          }
        }
      }
    },
    "%@." : {
      "comment" : "Ends the agent tally as a sentence",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。"
          }
        }
      }
    },
